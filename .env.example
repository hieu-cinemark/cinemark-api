ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://cinemark:cinemark@localhost:5432/cinemark
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CORS_ORIGINS=http://localhost:3000

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse this placeholder, and never commit a real one.
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
