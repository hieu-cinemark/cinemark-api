ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=console

KAFKA_BOOTSTRAP_SERVERS=

# Same Redis instance spider-hub connects to - read-only from here, just to
# report Facebook session token status. Defaults shown are fine for local dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# Cloudflare D1 - see app/services/d1.py. Leave unset to skip all D1 calls
# (the app still boots and /health works; every /<platform>/run and the
# ingest consumer just no-op instead of erroring).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Log files GET /logs/spider-hub and GET /logs/ingest tail (see
# app/api/routes/logs.py) - only meaningful if this process can see spider-hub's
# consumer.log on disk (same host, or the path is mounted). Defaults assume
# a sibling checkout layout (cinemark-api/ and spider-hub/ side by side);
# override if your deployment puts them elsewhere.
SPIDER_HUB_CONSUMER_LOG_PATH=
INGEST_CONSUMER_LOG_PATH=

# Same Supabase Postgres spider-hub reads account/proxy config from
# (platform_accounts / platform_proxies tables - see spider-hub's
# social_crawler/services/db.py). Backs the dashboard's Settings page
# (app/api/routes/settings.py). Leave unset to skip - /settings/* 502s
# instead of the app failing to boot.
DATABASE_URL=