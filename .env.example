LOG_LEVEL=INFO
LOG_FORMAT=console

# Authenticated Facebook uses the daily slots saved on the dashboard.
# Separate opt-in for hourly deep crawling and daily tracked-post refresh.
FACEBOOK_BACKGROUND_CRAWL_ENABLED=false

# Google News Light: refresh released movies every 72h. Key stays server-side.
SERPAPI_API_KEY=
TRAILERIX_API_KEY=
SERPAPI_TIMEOUT_SECONDS=120

KAFKA_BOOTSTRAP_SERVERS=

# Same Redis instance spider-hub connects to - read-only from here, just to
# report Facebook session token status. Defaults shown are fine for local dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# Cloudflare D1 - see app/services/d1.py. Leave unset to skip all D1 calls
# (the app still boots and /health works; every /<platform>/run and the
# ingest consumer just no-op instead of erroring).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
# D1 cinemark-config-db (tài khoản, proxy, lịch cào, cấu hình AI/proxy) - xem docs/config-db-d1.md
CLOUDFLARE_D1_CONFIG_DATABASE_ID=

# "local" makes every D1 call in app/services/d1.py hit a local SQLite file
# instead of Cloudflare's HTTP query API - no daily row-read quota for local
# dev. Defaults to cinemark-be's local mirror of this same database
# (../cinemark-be/.local-db/scraper.sqlite); refresh it via
# `npm run db:pull-local` in cinemark-be. Leave "remote" (or unset) to use
# the real D1 database via CLOUDFLARE_* above.
DB_MODE=remote
LOCAL_DB_PATH=

# Log files GET /logs/spider-hub and GET /logs/ingest tail (see
# app/api/routes/logs.py) - only meaningful if this process can see spider-hub's
# consumer.log on disk (same host, or the path is mounted). Defaults assume
# a sibling checkout layout (cinemark-api/ and spider-hub/ side by side);
# override if your deployment puts them elsewhere.
SPIDER_HUB_CONSUMER_LOG_PATH=
INGEST_CONSUMER_LOG_PATH=

# AI provider: base URL, API key and model are NOT env vars - add a provider and pick the active one in the dashboard's
# Settings > AI tab (D1 ai_providers / ai_settings). Env only tunes how much AI ingest uses:
# AI_POST_RELEVANCE_DAILY_CAP posts classified per UTC day (0 = off); AI_INGEST_RELEVANCE=false saves posts at ingest without
# waiting for the AI (a background job relabels them).
AI_POST_RELEVANCE_DAILY_CAP=9000
AI_INGEST_RELEVANCE=false

# R2 data lake (S3 API) - R2 API token scoped to the lake bucket only.
# See app/services/lake.py and app/workers/lake_writer/main.py.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LAKE_BUCKET=cinemark-lake

