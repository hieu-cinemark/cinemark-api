[Unit]
Description=cinemark-api Social Topic reports (AI comment clusters, summaries, scene names) for films in release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/cinemark-api
EnvironmentFile=/opt/cinemark-api/.env
# CPU-only VPS: cap torch threads and CPU share so crawling/ingest keep their cores.
Environment=OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
ExecStart=/opt/cinemark-api/.venv/bin/python -m scripts.jobs.social_topic_reports --max-films 3
User=app
Group=app
Nice=10
CPUQuota=200%
MemoryMax=3G
TimeoutStartSec=6h
StandardOutput=journal
StandardError=journal
