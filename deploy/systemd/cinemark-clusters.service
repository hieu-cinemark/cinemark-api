[Unit]
Description=cinemark-api comment topic clusters (cluster -> name -> summarize -> publish) for showing films
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/cinemark-api
EnvironmentFile=/opt/cinemark-api/.env
Environment=OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
ExecStart=/opt/cinemark-api/.venv/bin/python -m scripts.jobs.topic_clusters
User=app
Group=app
Nice=10
CPUQuota=200%
MemoryMax=3G
TimeoutStartSec=90min
StandardOutput=journal
StandardError=journal
